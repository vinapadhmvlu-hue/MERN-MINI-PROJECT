import { useEffect, useState } from "react"; import axios from "axios";
import "./App.css";

function App() {
const [food, setFood] = useState([]); const [orders, setOrders] = useState([]);

const [name, setName] = useState(""); const [rollNo, setRollNo] = useState(""); const [course, setCourse] = useState("");
const [foodItem, setFoodItem] = useState(""); const [quantity, setQuantity] = useState(1);

// Get food items
const getFood = () => { axios
.get("http://localhost:3000/food")
.then((response) => { setFood(response.data);
})
.catch((error) => { console.log(error);
});
};

// Get placed orders const getOrders = () => { axios




.get("http://localhost:3000/orders")
.then((response) => { setOrders(response.data);
})
.catch((error) => { console.log(error);
});
};

useEffect(() => { getFood(); getOrders();
}, []);

// Place order
const placeOrder = () => {
if (!name || !rollNo || !course || !foodItem || !quantity) { alert("Please fill all the details");
return;
}

const selectedFood = food.find( (item) => item.name === foodItem
);
const total = selectedFood.price * Number(quantity); const newOrder = {
name: name,
rollNo: Number(rollNo), course: course, foodItem: foodItem,
quantity: Number(quantity), price: selectedFood.price, total: total
};

axios
.post("http://localhost:3000/orders", newOrder)
.then((response) => { alert(response.data.message);

setName("");




setRollNo("");
setCourse("");
setFoodItem(""); setQuantity(1);

getOrders();
})
.catch((error) => { console.log(error); alert("Error placing order");
});
};

return (
<div className="container">

<h1>College Canteen Pre-Order System</h1>

{/* Food List */}
<h2>Available Food Items</h2>

<table border="1">
<thead>
<tr>
<th>Food Item</th>
<th>Price (₹)</th>
</tr>
</thead>

<tbody>
{food.map((item) => (
<tr key={item._id}>
<td>{item.name}</td>
<td>₹{item.price}</td>
</tr>
))}
</tbody>
</table>

<hr />

{/* Order Form */}
<h2>Student Order Form</h2>





<input type="text"
placeholder="Student Name" value={name}
onChange={(e) => setName(e.target.value)}
/>

<br />
<br />

<input type="number"
placeholder="Roll Number" value={rollNo}
onChange={(e) => setRollNo(e.target.value)}
/>
<br />
<br />
<input type="text"
placeholder="Course" value={course}
onChange={(e) => setCourse(e.target.value)}
/>

<br />
<br />
<select value={foodItem}
onChange={(e) => setFoodItem(e.target.value)}
>
<option value="">Select Food Item</option>

{food.map((item) => (
<option key={item._id} value={item.name}>
{item.name} - ₹{item.price}
</option>
))}
</select>

<br />
<br />





<input type="number" min="1"
placeholder="Quantity" value={quantity}
onChange={(e) => setQuantity(e.target.value)}
/>
<br />
<br />

<button onClick={placeOrder}> Place Order
</button>
<hr />
{/* Order List */}
<h2>Placed Orders</h2>

<table border="1">
<thead>
<tr>
<th>Name</th>
<th>Roll No</th>
<th>Course</th>
<th>Food Item</th>
<th>Quantity</th>
<th>Price</th>
<th>Total</th>
</tr>
</thead>

<tbody>
{orders.map((order, index) => (
<tr key={order._id || index}>
<td>{order.name}</td>
<td>{order.rollNo}</td>
<td>{order.course}</td>
<td>{order.foodItem}</td>
<td>{order.quantity}</td>
<td>₹{order.price}</td>
<td>₹{order.total}</td>
</tr>
))}




</tbody>
</table>

</div>
);}
export default App;
